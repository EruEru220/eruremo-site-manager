{
  "name": "eruremo-media-api",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare Worker and R2 media API for ERUREMO SiteManager",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "dev": "node scripts/dev-copy-editor.mjs && wrangler dev --local --ip 127.0.0.1 --port 8787",
    "dev:staging": "node scripts/dev-copy-editor.mjs && wrangler dev --local --env staging --ip 127.0.0.1 --port 8788",
    "deploy": "node scripts/deploy-guard.mjs",
    "deploy:staging": "node scripts/dev-copy-editor.mjs && wrangler deploy --env staging"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
