// ERUREMO SiteManager - Cloudflare Worker public example configuration
//
// Replace only the generic placeholders with identifiers from your own account.
// Never put API tokens, Access audience values, allowed email addresses, account
// IDs, access keys, or other secrets in this file. Use Worker Secrets or the
// gitignored worker/.dev.vars file.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Generic Worker name. Wrangler appends the environment name for named envs.
  "name": "your-worker-name",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // The top-level environment is local-only and creates no public workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },

  // Used by wrangler dev --local. Do not point local development at a remote bucket.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "your-media-local"
    }
  ],

  "d1_databases": [
    {
      "binding": "BOARD_DB",
      "database_name": "your-board-local",
      "database_id": "your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_MEDIA_BASE_URL": "http://127.0.0.1:8787",
    "MEDIA_MUTATIONS_ENABLED": "true",
    "MIGRATION_CANARY_MUTATION_ENABLED": "false",
    "MIGRATION_BATCH_MUTATION_ENABLED": "false"
  },

  "observability": {
    "enabled": true
  },

  "env": {
    "staging": {
      // This environment can have a workers.dev URL, but the application remains
      // fail-closed while STAGING_LOCKED is anything other than exactly "false".
      "workers_dev": true,
      "preview_urls": false,

      // Keep all staging requests behind the Worker so the access guard runs for
      // the admin page, API, media, and static assets.
      "assets": {
        "directory": "./public/",
        "binding": "ASSETS",
        "run_worker_first": true
      },

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "your-media-staging"
        }
      ],

      "d1_databases": [
        {
          "binding": "BOARD_DB",
          "database_name": "your-board-staging",
          "database_id": "your-d1-staging-database-id",
          "migrations_dir": "migrations"
        }
      ],

      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_MEDIA_BASE_URL": "",

        // Public example defaults: deny all staging traffic and all mutations.
        "STAGING_LOCKED": "true",
        "MEDIA_MUTATIONS_ENABLED": "false",
        "MIGRATION_CANARY_MUTATION_ENABLED": "false",
        "MIGRATION_BATCH_MUTATION_ENABLED": "false",

        // Public, non-secret team hostname. Replace with your own team domain.
        "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com"

        // ACCESS_AUD and ALLOWED_EMAILS must be Worker Secrets, not vars.
        // Legacy ALLOWED_EMAIL is accepted only when ALLOWED_EMAILS is absent.
      },

      "observability": {
        "enabled": true
      }
    },

    "production": {
      // Code-ready example only. No custom domain or route is created by this
      // repository. Configure the two hostnames deliberately before deployment.
      "workers_dev": false,
      "preview_urls": false,

      // This directory is generated by `npm run build:production-assets`.
      // Running the Worker before that build fails instead of deploying the
      // repository or the local/staging admin assets by mistake.
      "assets": {
        "directory": "./production-assets/",
        "binding": "ASSETS",
        "run_worker_first": true
      },

      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "your-media-production"
        }
      ],

      "d1_databases": [
        {
          "binding": "BOARD_DB",
          "database_name": "your-board-production",
          "database_id": "your-d1-production-database-id",
          "migrations_dir": "migrations"
        }
      ],

      "vars": {
        "ENVIRONMENT": "production",

        // Hostnames only: no scheme, port, path, wildcard, or trailing slash.
        // PUBLIC_HOST is anonymous and read-only; ADMIN_HOST requires Access.
        "PUBLIC_HOST": "www.example.com",
        "ADMIN_HOST": "admin.example.com",

        // Keep generated media URLs relative so both hosts can use /media/....
        "PUBLIC_MEDIA_BASE_URL": "",

        // Public example default: reads work, R2 writes/deletes do not.
        "MEDIA_MUTATIONS_ENABLED": "false",
        "MIGRATION_CANARY_MUTATION_ENABLED": "false",
        "MIGRATION_BATCH_MUTATION_ENABLED": "false",

        // Public, non-secret team hostname. Replace with your own team domain.
        "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com"

        // ACCESS_AUD and ALLOWED_EMAILS must be Worker Secrets, not vars.
        // Legacy ALLOWED_EMAIL is accepted only when ALLOWED_EMAILS is absent.
      },

      "observability": {
        "enabled": true
      }
    }
  }
}
